# Copy this file to .env and fill in your own values. Never commit .env.

# Required: the private key of the wallet that will mine and pay gas on
# Robinhood Chain. Keep this funded with a small amount of that chain's
# native gas token — mints themselves are free until Hash Broker #101.
PRIVATE_KEY=0xyourprivatekeyhere

# Optional overrides (defaults match the live hashbroker.fun deployment):
# RPC_URL=https://rpc.mainnet.chain.robinhood.com/
# CONTRACT_ADDRESS=0x4272D6f51771839F596082eF48fa84D35239Bab3
# CHAIN_ID_DECIMAL=4663
